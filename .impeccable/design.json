  "narrative": {
    "northStar": "Engineered Dark",
    "overview": "Engineered Dark combines charcoal grounds, violet interaction, emerald health signals, and restrained console notation. Inter carries human identity and explanatory reading; JetBrains Mono marks commands, roles, provenance, and technology data. The result is direct, technical, and accessible to a fast reader.\n\nThe Power-On Self-Test remains an identity reference through settled readiness markers and the dedicated terminal. It no longer requires every surface to simulate a boot screen. Space, ruled structure, and deliberate typographic hierarchy carry the interface.",
    "keyCharacteristics": [
      "Charcoal tonal layers with fine structural rules",
      "Inter for reading; JetBrains Mono for system notation",
      "Violet actions, emerald health, amber provenance",
      "Responsive columns with generous section spacing",
      "Settled content and reduced-motion support"
    ],
    "rules": [
      {
        "name": "The Health Signal Rule",
        "body": "Reserve emerald for availability, production status, and ready/check markers.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Inter for reading and hierarchy; use JetBrains Mono for commands, roles, tags, and technical notation.",
        "section": "typography"
      },
      {
        "name": "The Ruled Structure Rule",
        "body": "Separate sections and rows with hairline rules and tonal changes; keep persistent content flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the distinction between reading text and system notation.",
      "Do keep health markers semantic and primary actions violet.",
      "Do show genuine code destinations and allow long repository names to wrap.",
      "Do keep direct contact and locale navigation available without JavaScript.",
      "Do honor reduced motion and visible keyboard focus."
    ],
    "donts": [
      "Don't turn ordinary reading copy into a wall of console text.",
      "Don't add decorative glow or hard offset shadows to persistent content.",
      "Don't fabricate project evidence or metrics.",
      "Don't replace SVG interface icons with Unicode arrow glyphs."
    ]
  }
}
