---
import '../styles/global.css';
import '../styles/motion.css';
import SiteStatus from '../components/SiteStatus.astro';
import { THEME_STORAGE_KEY } from '../lib/theme';
import type { Locale } from '../data/translations';
import { localePath, ui, getSiteData } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  terminal?: boolean;
  projectPage?: boolean;
}
const { locale = 'es', terminal = false, projectPage = false } = Astro.props;
const { profile } = await getSiteData(locale);
const { title = profile.meta.title, description = ui[locale].description } = Astro.props;
const page = projectPage
  ? locale === 'es'
    ? 'proyectos/bazpos/'
    : 'projects/bazpos/'
  : terminal
    ? 'terminal/'
    : '';
const alternatePage = (lang: Locale) =>
  projectPage ? (lang === 'es' ? 'proyectos/bazpos/' : 'projects/bazpos/') : page;
const canonical = new URL(localePath(locale, page), profile.meta.ogUrl);
const socialImage = new URL('/social-card.png', profile.meta.ogUrl);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="oklch(98% 0.008 300)" />
    <script is:inline define:vars={{ themeStorageKey: THEME_STORAGE_KEY }}>
      (() => {
        let preference;
        try {
          preference = localStorage.getItem(themeStorageKey);
        } catch {}
        document.documentElement.dataset.theme =
          preference === 'light' || preference === 'dark'
            ? preference
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(localePath('es', alternatePage('es')), profile.meta.ogUrl)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(localePath('en', alternatePage('en')), profile.meta.ogUrl)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath('es', alternatePage('es')), profile.meta.ogUrl)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CL' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_CL'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Nicolás Bazaes — Fullstack Developer & Sysadmin. BazPOS · React · Django · Linux."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      try {
        const preferred =
          localStorage.getItem('nbazaes-locale') ?? localStorage.getItem('nb_portfolio_lang');
        if (
          preferred === 'en' &&
          ['/', '/terminal', '/terminal/', '/proyectos/bazpos', '/proyectos/bazpos/'].includes(
            location.pathname,
          )
        ) {
          location.replace(
            '/en' +
              (location.pathname.startsWith('/proyectos/bazpos')
                ? '/projects/bazpos/'
                : location.pathname === '/'
                  ? '/'
                  : '/terminal/') +
              location.search +
              location.hash,
          );
        }
      } catch {
        /* The complete Spanish page remains available without storage. */
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Lavender Working Directory: oversized identity, real interactive terminal and authentic BazPOS evidence.
    Shared light lavender surfaces, Rethink Sans reading, purple actions and IBM Plex Mono for commands.
    Preserve bilingual routes, progressive enhancement, project media and direct contact. -->
    <a class="skip-link" href="#main-content">
      {ui[locale].skip}
    </a>
    <slot />
    <SiteStatus locale={locale} />
  </body>
</html>
<script>
  import { saveLocale } from '../lib/locale';
  import { initThemeControls } from '../lib/theme';
  initThemeControls();
  // The URL is the source of truth; saving the choice never blocks navigation.
  const locale = document.documentElement.lang === 'en' ? 'en' : 'es';
  saveLocale(locale);
  document.querySelectorAll<HTMLAnchorElement>('[data-locale]').forEach((link) => {
    link.addEventListener('click', () => saveLocale(link.dataset.locale === 'en' ? 'en' : 'es'));
  });
</script>
