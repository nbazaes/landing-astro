---
import '../styles/global.css';
import type { Locale } from '../data/translations';
import { localePath, ui, getSiteData } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  terminal?: boolean;
  projectPage?: boolean;
}
const { locale = 'es', terminal = false, projectPage = false } = Astro.props;
const { profile } = await getSiteData(locale);
const { title = profile.meta.title, description = ui[locale].description } = Astro.props;
const page = projectPage
  ? locale === 'es'
    ? 'proyectos/bazpos/'
    : 'projects/bazpos/'
  : terminal
    ? 'terminal/'
    : '';
const alternatePage = (lang: Locale) =>
  projectPage ? (lang === 'es' ? 'proyectos/bazpos/' : 'projects/bazpos/') : page;
const canonical = new URL(localePath(locale, page), profile.meta.ogUrl);
const socialImage = new URL('/social-card.png', profile.meta.ogUrl);
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111319" />
    <link rel="icon" type="image/svg+xml" href="/logonb.svg" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(localePath('es', alternatePage('es')), profile.meta.ogUrl)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(localePath('en', alternatePage('en')), profile.meta.ogUrl)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath('es', alternatePage('es')), profile.meta.ogUrl)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CL' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_CL'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Nicolás Bazaes — Fullstack Developer & Sysadmin. BazPOS · React · Django · Linux."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      try {
        const preferred =
          localStorage.getItem('nbazaes-locale') ?? localStorage.getItem('nb_portfolio_lang');
        if (
          preferred === 'en' &&
          ['/', '/terminal', '/terminal/', '/proyectos/bazpos', '/proyectos/bazpos/'].includes(
            location.pathname,
          )
        ) {
          location.replace(
            '/en' +
              (location.pathname.startsWith('/proyectos/bazpos')
                ? '/projects/bazpos/'
                : location.pathname === '/'
                  ? '/'
                  : '/terminal/') +
              location.search +
              location.hash,
          );
        }
      } catch {
        /* The complete Spanish page remains available without storage. */
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- BAZPOS PRESENTATION CONTRACT: On project routes, demonstrate the real workflow inside Engineered Dark.
    OWN-WORLD: Incumbent charcoal surfaces, violet actions, Inter reading and JetBrains Mono architecture notation.
    STORY: Understand the automotive counter workflow, watch a real sale, inspect stock and reports, then explore the live demo.
    FIRST VIEWPORT: Project title, two-column introduction, sole external demo CTA and the beginning of a native walkthrough player.
    FORM: Adapt the existing BazPOS presentation into the portfolio; authentic recording, three screenshots, then architecture.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance. -->
    <!-- THESIS: A developer's work earns the first impression. BazPOS is the featured proof, with a compact console signature.
    OWN-WORLD: Engineered Dark; charcoal, violet actions, emerald status, Inter for reading and JetBrains Mono for system notation.
    STORY: Identify Nicolás, understand React frontend and Django backend through BazPOS, inspect code, make contact.
    FIRST VIEWPORT: Clear name and role, short proposition, two immediate actions and one settled console line; BazPOS follows.
    FORM: User-selected BazPOS project emphasis, extending the established Power-On Self-Test identity (7386437a).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance. -->
    <a class="skip-link" href="#main-content">
      {ui[locale].skip}
    </a>
    <slot />
    <div
      id="site-status"
      class="site-status"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    ></div>
  </body>
</html>
<script>
  import { saveLocale } from '../lib/locale';
  // The URL is the source of truth; saving the choice never blocks navigation.
  const locale = document.documentElement.lang === 'en' ? 'en' : 'es';
  saveLocale(locale);
  document.querySelectorAll<HTMLAnchorElement>('[data-locale]').forEach((link) => {
    link.addEventListener('click', () => saveLocale(link.dataset.locale === 'en' ? 'en' : 'es'));
  });
</script>
