---
---

<section id="stack" class="py-20 md:py-28 border-t border-white/10 relative">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono text-[#a855f7] mb-2 uppercase tracking-wider font-semibold">
        <span class="material-symbols-outlined text-sm">memory</span>
        <span data-i18n="stackKicker">CORE CAPABILITIES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight" data-i18n="stackTitle">
        Technical Focus
      </h2>
      <p class="text-sm sm:text-base text-[#cfc2d6] mt-2" data-i18n="stackSubtitle">
        Technologies and infrastructure paradigms I work with daily.
      </p>
    </div>

    <!-- 4-Column Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Backend & APIs -->
      <div class="glass-panel rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4 pb-3 border-b border-white/10">
            <div class="w-8 h-8 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex items-center justify-center text-[#a855f7]">
              <span class="material-symbols-outlined text-lg">dns</span>
            </div>
            <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider" data-i18n="stackCatBackendTitle">
              Backend &amp; APIs
            </h3>
          </div>
          <ul class="space-y-3 font-mono text-xs sm:text-sm text-[#cfc2d6]">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Python / Django</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Node.js / Express</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Go / Microservices</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>REST &amp; GraphQL APIs</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Systems & Sysadmin -->
      <div class="glass-panel rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4 pb-3 border-b border-white/10">
            <div class="w-8 h-8 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex items-center justify-center text-[#a855f7]">
              <span class="material-symbols-outlined text-lg">terminal</span>
            </div>
            <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider" data-i18n="stackCatSysadminTitle">
              Systems &amp; Sysadmin
            </h3>
          </div>
          <ul class="space-y-3 font-mono text-xs sm:text-sm text-[#cfc2d6]">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Linux / Bash Automation</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Docker Containerization</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Nginx &amp; Reverse Proxies</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Self-Hosting &amp; Tuning</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Frontend & SSR -->
      <div class="glass-panel rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4 pb-3 border-b border-white/10">
            <div class="w-8 h-8 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex items-center justify-center text-[#a855f7]">
              <span class="material-symbols-outlined text-lg">web</span>
            </div>
            <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider" data-i18n="stackCatFrontendTitle">
              Frontend &amp; SSR
            </h3>
          </div>
          <ul class="space-y-3 font-mono text-xs sm:text-sm text-[#cfc2d6]">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Astro / Static &amp; Islands</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>React / Single Page Apps</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>TypeScript</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Tailwind CSS &amp; UI</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Databases & Storage -->
      <div class="glass-panel rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4 pb-3 border-b border-white/10">
            <div class="w-8 h-8 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex items-center justify-center text-[#a855f7]">
              <span class="material-symbols-outlined text-lg">database</span>
            </div>
            <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider" data-i18n="stackCatDatabasesTitle">
              Databases &amp; Storage
            </h3>
          </div>
          <ul class="space-y-3 font-mono text-xs sm:text-sm text-[#cfc2d6]">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>PostgreSQL</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Redis (Caching / Queues)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>SQLite</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#a855f7] text-sm">chevron_right</span>
              <span>Django ORM &amp; Prisma</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>
