---
---

<footer id="contact" class="border-t border-white/10 bg-[#0e0e10] py-16 transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-10">
      
      <!-- Brand & Location & Email Pill -->
      <div class="flex flex-col items-center md:items-start gap-4 text-center md:text-left">
        <span class="font-mono text-sm font-bold text-[#a855f7] tracking-wider uppercase">
          NICOLÁS BAZAES
        </span>
        <p class="text-sm font-mono text-[#94a3b8] flex items-center gap-1.5">
          <span class="material-symbols-outlined text-base text-[#a855f7]">location_on</span>
          <span data-i18n="footerLocation">Los Ángeles, Chile</span>
        </p>

        <!-- Interactive Email Copy Pill -->
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-[#16161a] border border-white/10 hover:border-[#a855f7]/60 transition-colors mt-1">
          <span class="font-mono text-xs text-white select-all">nbazaes@bazaes.cl</span>
          <button
            id="footer-copy-email-btn"
            type="button"
            class="text-[#94a3b8] hover:text-[#a855f7] transition-colors cursor-pointer flex items-center"
            title="Copy Email"
            data-email="nbazaes@bazaes.cl"
          >
            <span class="material-symbols-outlined text-base">content_copy</span>
          </button>
        </div>
      </div>

      <!-- Links & Copyright -->
      <div class="flex flex-col items-center md:items-end gap-5 text-center md:text-right">
        <div class="flex flex-wrap items-center justify-center gap-6 text-sm font-mono text-[#94a3b8]">
          <a href="https://github.com/nbazaes" target="_blank" rel="noreferrer noopener" class="hover:text-white transition-colors">
            GitHub
          </a>
          <a href="mailto:nbazaes@bazaes.cl" class="hover:text-white transition-colors">
            Email
          </a>
          <a href="/terminal" class="hover:text-[#a855f7] transition-colors">
            CLI Mode
          </a>
          <a href="#" class="hover:text-white transition-colors" data-i18n="footerBackToTop">
            Back to Top ↑
          </a>
        </div>

        <p class="text-xs font-mono text-[#94a3b8]" data-i18n="footerRights">
          © 2026 Nicolás Bazaes. Engineered with precision.
        </p>
      </div>

    </div>
  </div>
</footer>

<script>
  const footerCopyBtn = document.getElementById('footer-copy-email-btn');
  footerCopyBtn?.addEventListener('click', async () => {
    const email = footerCopyBtn.getAttribute('data-email') || 'nbazaes@bazaes.cl';
    try {
      await navigator.clipboard.writeText(email);
      showFooterToast('Email copied to clipboard: ' + email);
    } catch (err) {
      console.error('Failed to copy', err);
    }
  });

  function showFooterToast(message: string) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = 'glass-panel bg-[#16161a]/95 text-white px-4 py-3 rounded-lg shadow-xl border border-[#a855f7]/50 text-xs sm:text-sm font-mono flex items-center gap-2 animate-toast pointer-events-auto';
    toast.innerHTML = `
      <span class="material-symbols-outlined text-[#a855f7] text-base">check_circle</span>
      <span>${message}</span>
    `;

    container.appendChild(toast);
    setTimeout(() => {
      toast.remove();
    }, 2300);
  }
</script>
