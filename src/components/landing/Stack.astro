---
import Icon from '../Icon.astro';
import { engineeringExamples } from '../../lib/engineering';
import type { Locale, TranslationData } from '../../data/translations';
interface Props {
  t: TranslationData;
  locale: Locale;
}
const { t, locale } = Astro.props;
const examples = engineeringExamples(locale);
---

<section id="stack" class="section container" aria-labelledby="stack-title">
  <div class="section-heading">
    <h2 id="stack-title">{t.stack.subtitle}</h2>
    <p>{t.stack.statusBadge}</p>
  </div>
  <div class="stack-grid" data-motion="enter">
    {t.stack.groups.map((group) => (
      <div class="stack-group">
        <h3>{group.title}</h3>
        <ul>
          {group.items.map((item) => (
            <li>
              <span>{item.name}</span>
              <span class="stack-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <section id="work" class="principles" aria-labelledby="work-title">
    <h3 id="work-title">
      {locale === 'es' ? 'Decisiones en proyectos reales' : 'Decisions in real projects'}
    </h3>
    <div>
      {examples.map((item) => (
        <div>
          <h4>{item.title}</h4>
          <p>{item.description}</p>
          <a href={item.href}>
            {item.label}
            <Icon name="external" />
          </a>
        </div>
      ))}
    </div>
  </section>
</section>
