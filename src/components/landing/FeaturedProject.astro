---
import type { Locale, ProjectData } from '../../data/translations';
import { ui, localePath } from '../../lib/site';
import Icon from '../Icon.astro';
interface Props {
  locale: Locale;
  project: ProjectData;
}
const { locale, project } = Astro.props;
const c = ui[locale];
---

<section id="bazpos" class="featured section" aria-labelledby="bazpos-title">
  <div class="container featured-heading">
    <h2 id="bazpos-title">{c.featureTitle}</h2>
    <p>{c.featureIntro}</p>
  </div>
  <div class="container feature-layout feature-scene">
    <a
      class="feature-preview"
      href={localePath(locale, locale === 'es' ? 'proyectos/bazpos/' : 'projects/bazpos/')}
    >
      <img
        src="/bazpos/reportes.webp"
        width="1440"
        height="900"
        loading="eager"
        decoding="async"
        alt={
          locale === 'es'
            ? 'Reportes de BazPOS con ventas de una tienda ficticia.'
            : 'BazPOS reports showing sales for a fictional store.'
        }
      />
      <span>
        {locale === 'es' ? 'Explorar BazPOS en funcionamiento' : 'Explore BazPOS in action'}
        <Icon name="arrow" />
      </span>
    </a>
    <div class="feature-story">
      <div class="feature-chapter">
        <span class="production-status">{c.production}</span>
        <p class="feature-description">
          {locale === 'es'
            ? 'Punto de venta con React, Django y MariaDB para gestionar ventas, inventario, proveedores, facturación y roles de usuario.'
            : 'A React, Django and MariaDB point of sale for sales, inventory, suppliers, invoicing and user roles.'}
        </p>
      </div>
      <div class="feature-chapter">
        <h3>{c.scope}</h3>
        <ul class="feature-list">
          {project.metrics[locale].map((metric) => (
            <li>{metric}</li>
          ))}
        </ul>
        <div class="actions">
          <a
            class="button primary"
            href={localePath(locale, locale === 'es' ? 'proyectos/bazpos/' : 'projects/bazpos/')}
          >
            {locale === 'es' ? 'Conocer el proyecto' : 'Explore the project'}
            <Icon name="arrow" />
          </a>
          <a
            class="button quiet"
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {c.repo}
            <Icon name="external" />
          </a>
        </div>
      </div>
      <div class="feature-chapter">
        <div class="feature-evidence">
          <div class="architecture" role="group" aria-labelledby="architecture-title">
            <div class="architecture-header">
              <h3 id="architecture-title">{c.architecture}</h3>
            </div>
            <ol class="architecture-layers">
              {project.architecture?.map((layer) => (
                <li>
                  <span class="layer-role">{layer.role[locale]}</span>
                  <strong>{layer.name}</strong>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <p class="repo-origin">
          <span>origin:</span> github.com/nbazaes/{project.name}
        </p>
      </div>
    </div>
  </div>
</section>
