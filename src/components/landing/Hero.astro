---
import type { Locale, TranslationData } from '../../data/translations';
import { ui } from '../../lib/site';
import Icon from '../Icon.astro';
import PortfolioTerminal from '../PortfolioTerminal.astro';
interface Props {
  locale: Locale;
  t: TranslationData;
}
const { locale, t } = Astro.props;
const c = ui[locale];
---

<section id="intro" class="hero container" aria-labelledby="intro-title">
  <div class="hero-heading">
    <h1 id="intro-title" data-motion-intro="title">
      Nicolás Bazaes
    </h1>
  </div>
  <div class="hero-copy" data-motion-intro="content">
    <p class="hero-statement">
      {locale === 'es'
        ? 'Desarrollo aplicaciones web y cuido la infraestructura que las mantiene.'
        : 'I build web applications and care for the infrastructure behind them.'}
    </p>
    <div class="actions">
      <a class="button primary" href="#bazpos">
        {c.featured}
        <Icon name="arrow" />
      </a>
      <a class="button quiet" href="#contact">
        {c.contact}
      </a>
    </div>
    <div class="hero-profile">
      <p class="hero-description">{c.role}</p>
      <div class="hero-status">
        <span>{t.hero.statusBadge}</span>
        <span class="hero-location">Los Ángeles, Chile</span>
      </div>
    </div>
  </div>
  <div class="hero-terminal" data-motion-intro="terminal">
    <PortfolioTerminal locale={locale} />
  </div>
</section>
