---
import Layout from '../../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import HeroWaveField from '../HeroWaveField.astro';
import FeaturedProject from './FeaturedProject.astro';
import Projects from './Projects.astro';
import Stack from './Stack.astro';
import Contact from './Contact.astro';
import Icon from '../Icon.astro';
import { getSiteData, ui } from '../../lib/site';
import type { Locale } from '../../data/translations';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t, profile, projects, featured } = await getSiteData(locale);
---

<Layout locale={locale} title={profile.meta.title} description={ui[locale].description}>
  <Header locale={locale} />
  <main id="main-content">
    <div class="hero-surface">
      <HeroWaveField />
      <Hero locale={locale} t={t} />
    </div>
    <FeaturedProject locale={locale} project={featured} />
    <Projects locale={locale} projects={projects} t={t} />
    <div class="stack-surface">
      <Stack t={t} locale={locale} />
    </div>
    <Contact locale={locale} profile={profile} />
  </main>
  <footer class="container site-footer">
    <span>
      © {new Date().getFullYear()} Nicolás Bazaes / {profile.location}
    </span>
    <a href="#intro">
      <Icon name="terminal" />
      {ui[locale].terminal}
    </a>
  </footer>
</Layout>

<style>
  .hero-surface {
    position: relative;
    isolation: isolate;
  }
  .hero-surface :global(.hero) {
    z-index: 1;
  }
</style>
