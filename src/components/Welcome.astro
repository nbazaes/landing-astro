---
import { getSiteData, localePath, ui } from '../lib/site';
import type { Locale } from '../data/translations';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { profile, t: translations, projects } = await getSiteData(locale);
const introCommand = profile.introCommand;
const infoLines = translations.terminal.infoLines;

// Timing constants (all in seconds)
const typingDuration = 0.9; // how long "login guest" takes to type
const postTypingPause = 0.4; // pause after typing before output appears
const lineDelay = 0.18; // gap between each info line appearing
const postOutputPause = 0.3; // pause after last line before prompt appears

// When does each info line start fading in?
const lineDelays = infoLines.map((_, i) => typingDuration + postTypingPause + i * lineDelay);

// When does the real input prompt appear?
const promptDelay = lineDelays[lineDelays.length - 1] + lineDelay + postOutputPause;
---

<div id="container">
  <main id="main-content">
    <section id="hero">
      <!-- Animated "login guest" line -->
      <p class="terminal-row intro-row">
        <span class="prompt-prefix">{profile.terminalPrompt}</span>
        <span
          class="animated-command"
          style={`--chars: ${introCommand.length}; --typing-duration: ${typingDuration}s;`}
        >
          {introCommand}
        </span>
      </p>

      <!-- Info lines, each fading in after the previous -->
      <div class="terminal-body">
        {infoLines.map((line, i) => (
          <p class="terminal-row info-line" style={`--line-delay: ${lineDelays[i].toFixed(2)}s;`}>
            {line}
          </p>
        ))}
      </div>

      <!-- Real input prompt, appears after all info lines -->
      <div
        id="terminal-output"
        role="log"
        aria-live="polite"
        aria-label={ui[locale].output}
        aria-relevant="additions"
      ></div>
      <div class="command-line" style={`--prompt-delay: ${promptDelay.toFixed(2)}s;`}>
        <span class="prompt-prefix">{profile.terminalPrompt}</span>
        <input
          type="text"
          id="terminal-input"
          placeholder={translations.terminal.placeholder}
          aria-label={ui[locale].input}
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
        />
      </div>
    </section>
    <noscript>
      <p>
        {locale === 'es'
          ? 'La terminal interactiva requiere JavaScript. Puedes explorar los proyectos y el contacto desde el portafolio.'
          : 'The interactive terminal requires JavaScript. You can explore projects and contact details in the portfolio.'}{' '}
        <a href={localePath(locale)}>{translations.terminal.backButton}</a>
      </p>
    </noscript>
  </main>
</div>

<script
  type="application/json"
  id="__terminal-data"
  set:html={JSON.stringify({
    t: translations.terminal,
    locale,
    home: localePath(locale),
    profile,
    projects: projects.map((p) => ({
      id: p.id,
      name: p.name,
      githubUrl: p.githubUrl,
      description: p.description,
    })),
  }).replace(/</g, '\u003c')}
></script>

<script>
  const siteData = JSON.parse(document.getElementById('__terminal-data')!.textContent!);

  const input = document.querySelector<HTMLInputElement>('#terminal-input');
  const commandLine = document.querySelector<HTMLElement>('.command-line');
  const output = document.querySelector<HTMLElement>('#terminal-output');
  const promptDelay = Number.parseFloat(
    commandLine?.style.getPropertyValue('--prompt-delay') ?? '0',
  );

  const promptText = siteData.profile.terminalPrompt;
  const locale: 'en' | 'es' = siteData.locale;
  const t = siteData.t;

  type OutputItem = string | HTMLElement;
  type CommandHandler = (args: string[]) => OutputItem[];

  // Helper: create a styled <a> link for use inside commands.
  const link = (text: string, href: string): HTMLAnchorElement => {
    const a = document.createElement('a');
    a.href = href;
    a.textContent = text;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.className = 'terminal-link';
    return a;
  };

  // Template: add your commands here.
  const commands: Record<string, CommandHandler> = {
    help: () => [t.availableCommands, ...t.helpLines],
    clear: () => {
      if (output) {
        output.innerHTML = '';
      }
      return [];
    },
    readme: () => [t.aboutMe, ...t.readmeLines],
    github: () => {
      const lines: OutputItem[] = [link(t.githubPortfolio, siteData.profile.githubUrl)];
      siteData.projects.forEach(
        (proj: { name: string; githubUrl: string; description: { en: string; es: string } }) => {
          lines.push(link(`${proj.name}:`, proj.githubUrl));
          lines.push(proj.description[locale]);
        },
      );
      return lines;
    },
    contact: () => [
      t.emailLabel,
      link(siteData.profile.email, `mailto:${siteData.profile.email}`),
      t.linkedin,
      link(siteData.profile.linkedinUrl, siteData.profile.linkedinUrl),
    ],
    gui: () => {
      window.location.href = siteData.home;
      return [t.openingGui];
    },
    sudo: () => [t.sudoMessage],
    'rm -rf /': () => [...t.rmRootLines],
  };

  const appendOutput = (lines: OutputItem[]) => {
    if (!output) return;

    const fragment = document.createDocumentFragment();
    for (const line of lines) {
      const row = document.createElement('p');
      row.className = 'output-row terminal-row';
      if (typeof line === 'string') {
        row.textContent = line;
      } else {
        row.appendChild(line);
      }
      fragment.appendChild(row);
    }

    output.appendChild(fragment);
  };

  const appendPromptCommand = (command: string) => {
    if (!output) return;

    const row = document.createElement('p');
    row.className = 'output-row terminal-row';

    const prefix = document.createElement('span');
    prefix.className = 'prompt-prefix';
    prefix.textContent = promptText;

    const commandText = document.createTextNode(` ${command}`);

    row.append(prefix, commandText);
    output.appendChild(row);
  };

  const scrollToLatest = () => {
    window.requestAnimationFrame(() => {
      commandLine?.scrollIntoView({
        block: 'end',
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'instant'
          : 'smooth',
      });
    });
  };

  const runCommand = (rawValue: string) => {
    const trimmed = rawValue.trim();
    if (!trimmed) return;

    appendPromptCommand(trimmed);

    const normalized = trimmed.toLowerCase();

    // First try an exact command match (supports multi-word commands).
    let handler = Object.hasOwn(commands, normalized) ? commands[normalized] : undefined;
    let name = normalized;
    let args: string[] = [];

    // Fallback to command + args matching.
    if (!handler) {
      [name, ...args] = normalized.split(/\s+/);
      handler = Object.hasOwn(commands, name) ? commands[name] : undefined;
    }

    if (!handler) {
      appendOutput([`${t.commandNotFound} ${trimmed}`, t.typeHelp]);
      scrollToLatest();
      return;
    }

    const result = handler(args);
    appendOutput(result);
    scrollToLatest();
  };

  // Focus the input once the prompt has appeared
  window.setTimeout(
    () => {
      if (window.matchMedia('(pointer: fine)').matches) input?.focus({ preventScroll: true });
    },
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : promptDelay * 1000,
  );

  input?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    runCommand(input.value);
    input.value = '';
    input.removeAttribute('placeholder');
  });
</script>

<style>
  #container {
    --terminal-fg: var(--color-text-bright);
    font-family: var(--font-mono);
    min-height: 100vh;
    border: 1px solid var(--color-border-primary);
    margin: 0;
    background: var(--color-surface-card);
  }

  main {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding: clamp(20px, 5vw, 60px);
  }

  #hero {
    width: min(100%, 920px);
  }

  .terminal-body {
    padding: 0;
  }

  .terminal-row {
    margin: 0;
    color: var(--terminal-fg);
    font-size: clamp(1rem, 1.9vw, 1.25rem);
    line-height: 1.7;
    letter-spacing: 0.02em;
  }

  /* ── "login guest" typing row ── */
  .intro-row {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
    white-space: nowrap;
  }

  :global(.prompt-prefix) {
    flex: 0 0 auto;
  }

  .animated-command {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    /* start fully clipped, animate to fully visible */
    clip-path: inset(0);
    animation: typing var(--typing-duration) steps(var(--chars), end) forwards;
  }

  /* Blinking cursor on the typed command — disappears when typing ends */
  .animated-command::after {
    content: '';
    display: inline-block;
    width: 0.65ch;
    height: 1.1em;
    margin-left: 0.12ch;
    vertical-align: -0.15em;
    background: var(--terminal-fg);
    /* fade out exactly when typing finishes, then stay hidden */
    animation: cursor-stop var(--typing-duration) steps(1, end) forwards;
  }

  /* ── Info lines ── */
  .info-line {
    opacity: 1;
    animation: line-appear 0.15s ease-out forwards;
    animation-delay: var(--line-delay);
  }

  /* ── Real prompt + input ── */
  .command-line {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
    margin-top: 4px;
    opacity: 1;
    animation: line-appear 0.15s ease-out forwards;
    animation-delay: var(--prompt-delay);
  }

  #terminal-input {
    min-width: 0;
    width: min(100%, 32rem);
    background: transparent;
    border: none;
    color: var(--terminal-fg);
    font-family: inherit;
    font-size: clamp(1rem, 1.9vw, 1.25rem);
    line-height: 1.7;
    letter-spacing: 0.02em;

    flex-grow: 1;
    caret-color: var(--terminal-fg);
    animation: blink-caret 1.05s steps(1, end) infinite;
  }

  #terminal-input::placeholder {
    color: var(--color-text-muted);
  }

  #terminal-output {
    color: var(--terminal-fg);
    font-size: clamp(1rem, 1.9vw, 1.25rem);
  }

  :global(#terminal-output .output-row) {
    line-height: 1.65;
    overflow-wrap: anywhere;
    color: var(--color-primary-light);
    font-weight: 400;
  }

  :global(.terminal-link),
  :global(.terminal-link:visited) {
    color: var(--terminal-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  :global(.terminal-link:hover) {
    color: var(--color-primary-light);
  }

  :global(.prompt-prefix) {
    color: var(--color-primary-light);
    font-weight: 400;
    font-size: clamp(1rem, 1.9vw, 1.25rem);
  }

  /* ── Keyframes ── */

  @keyframes typing {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Cursor is visible while typing, gone once done */
  @keyframes cursor-stop {
    0% {
      opacity: 1;
    }
    99% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Simple fade-in for info lines and the prompt */
  @keyframes line-appear {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes blink-caret {
    0%,
    49% {
      caret-color: var(--terminal-fg);
    }
    50%,
    100% {
      caret-color: transparent;
    }
  }

  /* ── Mobile ── */
  @media (prefers-reduced-motion: reduce) {
    .info-line,
    .command-line {
      opacity: 1;
    }
    .animated-command {
      clip-path: none;
    }
    .animated-command::after {
      display: none;
    }
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }

    #hero {
      width: 100%;
    }

    .intro-row,
    .command-line {
      gap: 0.45ch;
      flex-wrap: wrap;
    }
    .intro-row {
      white-space: normal;
    }
    #terminal-input {
      flex-basis: 100%;
      width: 100%;
    }
    .terminal-row {
      overflow-wrap: anywhere;
    }
  }
</style>
