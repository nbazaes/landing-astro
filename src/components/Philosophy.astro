---
---

<section id="about" class="py-20 md:py-28 border-t border-white/10 relative">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Title & Overview -->
      <div class="lg:col-span-5 space-y-4">
        <div class="inline-flex items-center gap-1.5 text-xs font-mono text-[#a855f7] uppercase tracking-wider font-semibold">
          <span class="material-symbols-outlined text-sm">verified</span>
          <span data-i18n="philosophyKicker">ENGINEERING PHILOSOPHY</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight" data-i18n="philosophyTitle">
          Pragmatic Principles
        </h2>
        <p class="text-sm sm:text-base text-[#cfc2d6] leading-relaxed" data-i18n="philosophySubtitle">
          I build systems designed to be read, maintained, and scaled reliably by humans. Architecture should serve real products and users, not artificial complexity.
        </p>
      </div>

      <!-- Right Column: 3 Pillars Card -->
      <div class="lg:col-span-7">
        <div class="glass-panel rounded-xl p-6 sm:p-8 space-y-8">
          
          <!-- Pillar 1 -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex-shrink-0 flex items-center justify-center text-[#a855f7]">
              <span class="material-symbols-outlined text-xl">task_alt</span>
            </div>
            <div class="space-y-1">
              <h3 class="text-base sm:text-lg font-bold text-white" data-i18n="philosophyCleanCodeTitle">
                Clean code over clever code
              </h3>
              <p class="text-xs sm:text-sm text-[#cfc2d6] leading-relaxed" data-i18n="philosophyCleanCodeDesc">
                Readability, maintainability, and predictable patterns supersede obscure micro-optimizations. Code is read far more often than it is written.
              </p>
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex-shrink-0 flex items-center justify-center text-[#a855f7]">
              <span class="material-symbols-outlined text-xl">compress</span>
            </div>
            <div class="space-y-1">
              <h3 class="text-base sm:text-lg font-bold text-white" data-i18n="philosophyMinimalBloatTitle">
                Minimal bloat &amp; purpose
              </h3>
              <p class="text-xs sm:text-sm text-[#cfc2d6] leading-relaxed" data-i18n="philosophyMinimalBloatDesc">
                Fewer dependencies mean fewer security vulnerabilities and zero maintenance overhead. Build what you need cleanly.
              </p>
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex-shrink-0 flex items-center justify-center text-[#a855f7]">
              <span class="material-symbols-outlined text-xl">terminal</span>
            </div>
            <div class="space-y-1">
              <h3 class="text-base sm:text-lg font-bold text-white" data-i18n="philosophyTerminalFirstTitle">
                Terminal-first workflow
              </h3>
              <p class="text-xs sm:text-sm text-[#cfc2d6] leading-relaxed" data-i18n="philosophyTerminalFirstDesc">
                Unmatched operational efficiency through Linux mastery, automated shell scripts, and command-line tooling.
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
