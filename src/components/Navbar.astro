---
---

<header class="fixed top-0 left-0 w-full z-40 bg-[#131315]/80 backdrop-blur-xl border-b border-white/10 transition-all duration-300">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#" class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-[#16161a] border border-[#a855f7]/40 flex items-center justify-center text-[#a855f7] font-mono text-sm font-bold group-hover:border-[#a855f7] group-hover:shadow-[0_0_12px_rgba(168,85,247,0.4)] transition-all">
        NB
      </div>
      <span class="font-bold tracking-tight text-white text-base sm:text-lg group-hover:text-[#ddb7ff] transition-colors">
        NICOLÁS BAZAES
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#projects" class="text-sm font-medium text-[#cfc2d6] hover:text-[#a855f7] transition-colors" data-i18n="navProjects">
        Projects
      </a>
      <a href="#stack" class="text-sm font-medium text-[#cfc2d6] hover:text-[#a855f7] transition-colors" data-i18n="navStack">
        Stack
      </a>
      <a href="#about" class="text-sm font-medium text-[#cfc2d6] hover:text-[#a855f7] transition-colors" data-i18n="navAbout">
        Philosophy
      </a>
      <a href="#contact" class="text-sm font-medium text-[#cfc2d6] hover:text-[#a855f7] transition-colors" data-i18n="navContact">
        Contact
      </a>
    </nav>

    <!-- Actions: Terminal Mode, Lang Switcher, Mobile Menu -->
    <div class="flex items-center gap-3">
      <!-- Terminal CLI Link -->
      <a
        href="/terminal"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-mono font-medium bg-[#16161a] text-[#cdbdff] border border-white/10 hover:border-[#a855f7]/60 hover:text-white transition-all shadow-sm"
        title="Open CLI Terminal Emulator"
      >
        <span class="text-[#a855f7]">&gt;_</span>
        <span data-i18n="navTerminalBtn">CLI Mode</span>
      </a>

      <!-- Language Toggle Button -->
      <button
        id="lang-toggle-btn"
        type="button"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md text-xs font-mono font-semibold bg-[#16161a] text-[#e5e1e4] border border-white/10 hover:border-[#a855f7]/60 hover:text-[#ddb7ff] transition-all cursor-pointer"
        aria-label="Switch language"
      >
        <span class="material-symbols-outlined text-[15px] text-[#a855f7]">translate</span>
        <span id="lang-current-label">ES</span>
      </button>

      <!-- Primary Contact CTA -->
      <a
        href="#contact"
        class="hidden lg:inline-flex items-center justify-center px-4 py-1.5 rounded-md text-xs font-semibold bg-[#a855f7] hover:bg-[#b76dff] text-white transition-all shadow-[0_0_12px_rgba(168,85,247,0.3)] hover:shadow-[0_0_18px_rgba(168,85,247,0.5)]"
        data-i18n="navResumeBtn"
      >
        Contact Me
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden p-2 rounded-lg text-[#cfc2d6] hover:text-white hover:bg-white/5 transition-colors"
        aria-label="Toggle menu"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-[#131315]/95 backdrop-blur-2xl px-6 py-5 space-y-4">
    <a href="#projects" class="block text-base font-medium text-[#cfc2d6] hover:text-[#a855f7] mobile-nav-link" data-i18n="navProjects">
      Projects
    </a>
    <a href="#stack" class="block text-base font-medium text-[#cfc2d6] hover:text-[#a855f7] mobile-nav-link" data-i18n="navStack">
      Stack
    </a>
    <a href="#about" class="block text-base font-medium text-[#cfc2d6] hover:text-[#a855f7] mobile-nav-link" data-i18n="navAbout">
      Philosophy
    </a>
    <a href="#contact" class="block text-base font-medium text-[#cfc2d6] hover:text-[#a855f7] mobile-nav-link" data-i18n="navContact">
      Contact
    </a>
    <div class="pt-3 border-t border-white/10 flex items-center justify-between">
      <a
        href="/terminal"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs font-mono font-medium bg-[#16161a] text-[#cdbdff] border border-white/10"
      >
        <span class="text-[#a855f7]">&gt;_</span>
        <span data-i18n="navTerminalBtn">CLI Mode</span>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg text-xs font-semibold bg-[#a855f7] text-white"
        data-i18n="navResumeBtn"
      >
        Contact Me
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
