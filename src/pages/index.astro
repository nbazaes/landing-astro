---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { Locale, TranslationData } from '../data/translations';

const profile = (await getCollection('profile'))[0];
const siteEntries = await getCollection('site');
const projects = await getCollection('projects');

const translations = {
  en: siteEntries.find((s) => s.id === 'en')!.data,
  es: siteEntries.find((s) => s.id === 'es')!.data,
} as Record<Locale, TranslationData>;

const defaultLocale: Locale = profile.data.defaultLocale;
const t = translations[defaultLocale];
const initialProjects = projects.map((p) => ({ ...p.data, id: p.id }));

const toneStyle = (tone: string, accent: string) => {
  switch (tone) {
    case 'muted':
      return 'color:#94a3b8';
    case 'strong':
      return 'color:#ffffff;font-weight:700';
    case 'soft':
      return `color:${accent}`;
    default:
      return `color:${accent};font-weight:700`;
  }
};

const bootSteps = [
  { key: "cpu", ts: "t=0.00s", label: "CPU", i18nVal: "heroTerminalRole" },
  { key: "mem", ts: "t=0.06s", label: "MEM", i18nVal: "heroBootMem" },
  { key: "nic", ts: "t=0.12s", label: "NIC", i18nVal: "heroTerminalInfra" },
];
---

<Layout title={profile.data.meta.title} description={profile.data.meta.description}>

  <!-- Fixed Top Navigation Bar (console status line) -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-[#111319]/95 border-b border-[#2d3139]">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between gap-3">
      <div class="flex items-center gap-6 min-w-0">
        <a href="#top" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-7 h-7 rounded bg-[#0c0e14] border border-[#a855f7]/60 group-hover:border-[#a855f7] flex items-center justify-center text-[#ddb7ff] group-hover:text-white font-bold text-[11px] transition-all">
            NB
          </div>
          <span class="font-mono text-xs font-semibold tracking-tight text-white group-hover:text-[#ddb7ff] transition-colors hidden sm:inline">
            bazaes@sys-core:~$
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-5 text-xs font-mono text-[#94a3b8]">
          <a href="#overview" class="hover:text-[#ddb7ff] transition-colors" data-i18n="navOverview">[1] Overview</a>
          <a href="#projects" class="hover:text-[#ddb7ff] transition-colors" data-i18n="navProjects">[2] Projects</a>
          <a href="#stack" class="hover:text-[#ddb7ff] transition-colors" data-i18n="navStack">[3] Stack</a>
          <a href="#philosophy" class="hover:text-[#ddb7ff] transition-colors" data-i18n="navPhilosophy">[4] Philosophy</a>
        </nav>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Terminal CLI Launcher -->
        <a
          href="/terminal"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded bg-[#191b22] border border-[#2d3139] hover:border-[#a855f7] text-[#ddb7ff] hover:text-white text-xs font-semibold transition-all"
          title="Open interactive CLI emulator"
        >
          <span class="text-[#a855f7] font-bold">&gt;_</span>
          <span data-i18n="navCli" class="hidden sm:inline">Terminal CLI</span>
        </a>

        <!-- Language Switcher Button -->
        <button
          id="lang-toggle-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded bg-[#191b22] border border-[#2d3139] hover:border-[#a855f7] text-xs font-bold text-white hover:text-[#ddb7ff] transition-all cursor-pointer"
          aria-label="Switch language between Spanish and English"
        >
          <span class="material-symbols-outlined text-[15px] text-[#a855f7]">translate</span>
          <span id="lang-current-label">ES</span>
        </button>

        <!-- Quick Copy Email Button -->
        <button
          id="nav-copy-email-btn"
          type="button"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#9333ea] hover:bg-[#a855f7] text-white text-xs font-bold transition-all cursor-pointer"
          data-email={profile.data.email}
        >
          <span class="material-symbols-outlined text-sm">content_copy</span>
          <span data-i18n="navCopyEmail">Email</span>
        </button>
      </div>
    </div>
  </header>

  <main id="top" class="pt-14 pb-20 relative z-10">
    <!-- SECTION 1: HERO — the Power-On Self-Test screen -->
    <section id="overview" class="py-10 sm:py-12 min-h-[calc(92vh-3.5rem)] flex flex-col justify-center">
      <div class="bg-[#0c0e14] border-y border-[#2d3139] px-6 sm:px-10 py-6 sm:py-8 relative overflow-hidden">
        <div class="max-w-6xl mx-auto">
        <!-- BIOS header line -->
        <div class="flex items-center justify-between gap-4 border-b border-[#2d3139] pb-3 mb-6 text-[11px] font-mono">
          <span class="text-[#94a3b8] truncate">
            <span class="text-[#a855f7] font-bold">&gt;_</span>
            <span data-i18n="heroTerminalTitle">nb@sys-core:~</span>
          </span>
          <span class="text-[#fabc4e] font-bold tracking-wider text-right hidden sm:inline" data-i18n="heroBootBrand">BAZAES_SYSTEM v2.7 · Power-On Self Test</span>
        </div>

        <!-- Availability Status -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#191b22] border border-[#2d3139] text-xs font-mono text-[#cfc2d6]">
          <span class="w-2 h-2 rounded-full bg-emerald-400 status-dot"></span>
          <span data-i18n="heroStatusBadge">Available for Hire • Fullstack &amp; Sysadmin • Los Ángeles, Chile</span>
        </div>

        <!-- Headline -->
        <h1 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15] font-sans max-w-3xl">
          <span data-i18n="heroHeadline">Engineering reliable web systems, APIs &amp; Linux cloud infrastructure.</span>
        </h1>

        <!-- Crisp Value Proposition -->
        <p class="mt-4 text-sm sm:text-base text-[#94a3b8] leading-relaxed max-w-2xl" data-i18n="heroSubtext">
          Junior Fullstack Developer &amp; Sysadmin in Chile. Specializing in Python/Django, Node.js, and Go backend engineering, performant frontends with React and Astro, and self-hosted Linux servers with Docker.
        </p>

        <!-- POST check sequence -->
        <div id="boot-screen" class="mt-6 sm:mt-8 font-mono text-[13px] sm:text-sm leading-relaxed space-y-1.5">
          {bootSteps.map((step) => (
            <p class="post-line flex items-baseline gap-2 sm:gap-3 text-[#cfc2d6]" data-step>
              <span class="text-[#fabc4e] tnum shrink-0">{step.ts}</span>
              <span class="text-[#94a3b8] shrink-0">{step.label}</span>
              <span class="text-[#ddb7ff]">
                [ <span data-i18n={step.i18nVal}></span> ]
              </span>
              <span class="flex-1 border-b border-dotted border-[#2d3139] hidden sm:inline-block"></span>
              <span class="ok-token text-emerald-400 font-bold">[ OK ]</span>
            </p>
          ))}

          {initialProjects.map((proj, idx) => (
            <p class="post-line flex items-baseline gap-2 sm:gap-3 text-[#cfc2d6]" data-step>
              <span class="text-[#fabc4e] tnum shrink-0 hidden sm:inline">t={(0.18 + idx * 0.06).toFixed(2)}s</span>
              <span class="text-[#94a3b8] shrink-0" data-i18n="heroBootMountPrefix">MOUNT</span>
              <a href={proj.githubUrl} target="_blank" rel="noreferrer noopener" class="text-[#ddb7ff] hover:text-white transition-colors min-w-0 break-all">
                /srv/{proj.name}
              </a>
              <span class="flex-1 border-b border-dotted border-[#2d3139] hidden sm:inline-block"></span>
              <span class="ok-token text-emerald-400 font-bold">[ OK ]</span>
            </p>
          ))}

          <!-- READY line -->
          <p class="post-line flex items-center gap-2 sm:gap-3 pt-3" data-step>
            <span class="flex-1 border-b border-dotted border-[#2d3139] hidden sm:inline-block"></span>
            <span class="ok-token text-emerald-400 font-bold">[ OK ]</span>
          </p>

          <p class="post-line flex items-center gap-2 pt-1 text-emerald-400 font-bold" data-step>
            <span class="w-2 h-2 rounded-full bg-emerald-400 status-dot shrink-0"></span>
            <span data-i18n="heroBootReady">BOOT SEQUENCE COMPLETE — SYSTEM READY</span>
            <span class="terminal-cursor" aria-hidden="true"></span>
          </p>
        </div>

        <!-- Keyed actions -->
        <div class="mt-6 sm:mt-8 pt-5 border-t border-[#2d3139] font-mono text-sm flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#9333ea] hover:bg-[#a855f7] text-white font-bold transition-all"
          >
            <span class="text-white font-bold">[1]</span>
            <span data-i18n="heroCtaProjects">View Projects</span>
          </a>

          <a
            href="/terminal"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#191b22] border border-[#2d3139] hover:border-[#a855f7] text-[#ddb7ff] hover:text-white font-bold transition-all"
          >
            <span class="text-[#a855f7] font-bold">[2]</span>
            <span data-i18n="heroCtaTerminal">Open Terminal ($)</span>
          </a>

          <button
            id="hero-copy-email-btn"
            type="button"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-transparent border border-[#2d3139] hover:border-[#a855f7] text-[#94a3b8] hover:text-white text-sm font-semibold transition-all cursor-pointer"
            data-email={profile.data.email}
          >
            <span class="text-[#a855f7] font-bold">[3]</span>
            <span class="material-symbols-outlined text-base">content_copy</span>
            <span>{profile.data.email}</span>
          </button>
        </div>

        <!-- BIOS footer note -->
        <p class="mt-8 text-[11px] font-mono text-[#94a3b8]" data-i18n="heroFooterNote">
          {t.hero.footerNote}
        </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: FEATURED PROJECTS — detected devices -->
    <section id="projects" class="max-w-6xl mx-auto px-6 py-20 border-t border-[#2d3139]/60 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#2d3139] pb-4">
        <div>
          <span class="text-xs font-mono text-[#a855f7] uppercase tracking-wider" data-i18n="projectsTitle">
            DIRECTORY_LISTING (~/projects)
          </span>
          <h2 class="text-2xl font-bold text-white tracking-tight mt-1" data-i18n="projectsSubtitle">
            Featured Engineering Projects
          </h2>
        </div>
        <span class="text-xs text-emerald-400 font-mono font-bold" data-i18n="projectsCountBadge">{t.projects.countBadge.replace('{count}', String(initialProjects.length))}</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {initialProjects.map((proj) => (
          <article class="p-6 sm:p-7 rounded-lg bg-[#0c0e14] border border-[#2d3139] hover:border-[#a855f7]/60 transition-all flex flex-col justify-between space-y-6 group">
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="material-symbols-outlined text-[#a855f7] text-lg shrink-0">{proj.iconName}</span>
                  <h3 class="text-base font-bold text-white group-hover:text-[#ddb7ff] transition-colors font-mono leading-snug min-w-0">
                    <a href={proj.githubUrl} target="_blank" rel="noreferrer noopener" class="break-words">
                      {proj.name}
                    </a>
                  </h3>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#191b22] text-[#ddb7ff] border border-[#2d3139] font-mono shrink-0" data-i18n={`projectCat_${proj.id}`}>
                  {proj.category[defaultLocale]}
                </span>
              </div>

              <p class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed" data-i18n={`projectDesc_${proj.id}`}>
                {proj.description[defaultLocale]}
              </p>

              <ul class="text-xs text-[#cfc2d6] space-y-1 font-mono pt-2 border-t border-[#2d3139]/50">
                {proj.metrics[defaultLocale].map((metric, i) => (
                  <li data-i18n={`projectMetric_${proj.id}_${i}`}>
                    <span class="text-[#a855f7]">▪</span> {metric}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Provenance ticket + action links -->
            <div class="pt-4 border-t border-[#2d3139] space-y-3 text-xs">
              <p class="font-mono text-[#94a3b8] truncate">
                <span class="text-[#fabc4e]">origin:</span> github.com/nbazaes/{proj.name}
              </p>

              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap gap-1.5">
                  {proj.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded bg-[#191b22] text-[#cfc2d6] text-[11px] font-mono border border-[#2d3139]/60">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-4">
                  <a
                    href={proj.githubUrl}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="text-[#94a3b8] hover:text-white flex items-center gap-1.5 transition-colors font-semibold"
                  >
                    <span class="material-symbols-outlined text-sm">code</span>
                    <span data-i18n="projectsViewCode">Source Code</span>
                  </a>

                  {proj.demoUrl && (
                    <a
                      href={proj.demoUrl}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="text-[#a855f7] hover:text-[#ddb7ff] flex items-center gap-1.5 transition-colors font-bold"
                    >
                      <span class="material-symbols-outlined text-sm">open_in_new</span>
                      <span data-i18n="projectsLiveDemo">Live Demo</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 3: TECHNICAL MATRIX — loaded core dependencies -->
    <section id="stack" class="max-w-6xl mx-auto px-6 py-20 border-t border-[#2d3139]/60 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#2d3139] pb-4">
        <div>
          <span class="text-xs font-mono text-[#a855f7] uppercase tracking-wider" data-i18n="stackTitle">
            CORE_DEPENDENCIES
          </span>
          <h2 class="text-2xl font-bold text-white tracking-tight mt-1" data-i18n="stackSubtitle">
            Technical Matrix &amp; Tools
          </h2>
        </div>
        <span class="text-xs text-emerald-400 font-mono font-bold" data-i18n="stackStatusBadge">{t.stack.statusBadge}</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-xs">
        {t.stack.groups.map((group) => (
          <div class="p-5 rounded-lg bg-[#0c0e14] border border-[#2d3139] space-y-4">
            <div class="flex items-center justify-between border-b border-[#2d3139] pb-2">
              <span class="font-bold text-white text-sm">{group.title}</span>
              <span class="material-symbols-outlined text-base" style={`color:${group.accent}`}>{group.icon}</span>
            </div>
            <ul class="space-y-2 text-[#cfc2d6] font-mono">
              {group.items.map((item) => (
                <li class="flex items-center justify-between gap-2">
                  <span class="text-white">{item.name}</span>
                  <span style={toneStyle(item.tone, group.accent)}>{item.label}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 4: ENGINEERING PRINCIPLES -->
    <section id="philosophy" class="max-w-6xl mx-auto px-6 py-20 border-t border-[#2d3139]/60 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#2d3139] pb-4">
        <div>
          <span class="text-xs font-mono text-[#a855f7] uppercase tracking-wider" data-i18n="philosophyTitle">
            PRAGMATIC_PRINCIPLES
          </span>
          <h2 class="text-2xl font-bold text-white tracking-tight mt-1" data-i18n="philosophySubtitle">
            Engineering Tenets
          </h2>
        </div>
        <span class="text-xs text-[#94a3b8] font-mono">/etc/sysctl.conf</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-lg bg-[#0c0e14] border border-[#2d3139] space-y-3 hover:border-[#a855f7]/60 transition-all">
          <div class="text-xl font-extrabold text-[#a855f7] font-mono">01</div>
          <h3 class="text-base font-bold text-white" data-i18n="philosophyItem1Title">
            Clean code over clever code
          </h3>
          <p class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed" data-i18n="philosophyItem1Desc">
            Readability and predictable patterns supersede obscure micro-optimizations. Code is read far more often than written.
          </p>
        </div>

        <div class="p-6 rounded-lg bg-[#0c0e14] border border-[#2d3139] space-y-3 hover:border-[#a855f7]/60 transition-all">
          <div class="text-xl font-extrabold text-[#a855f7] font-mono">02</div>
          <h3 class="text-base font-bold text-white" data-i18n="philosophyItem2Title">
            Minimal bloat &amp; purpose
          </h3>
          <p class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed" data-i18n="philosophyItem2Desc">
            Fewer dependencies mean fewer security vulnerabilities and zero maintenance overhead. Build what you need cleanly.
          </p>
        </div>

        <div class="p-6 rounded-lg bg-[#0c0e14] border border-[#2d3139] space-y-3 hover:border-[#a855f7]/60 transition-all">
          <div class="text-xl font-extrabold text-[#a855f7] font-mono">03</div>
          <h3 class="text-base font-bold text-white" data-i18n="philosophyItem3Title">
            Terminal-first workflow
          </h3>
          <p class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed" data-i18n="philosophyItem3Desc">
            Maximum operational efficiency achieved through Linux mastery, automation scripts, and command-line tooling.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 5: INTERACTIVE TERMINAL PROMO BANNER -->
    <section class="max-w-6xl mx-auto px-6 py-10">
      <div class="rounded-lg bg-[#0c0e14] border border-[#a855f7]/40 p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <h3 class="text-lg sm:text-xl font-bold text-white" data-i18n="terminalPromoTitle">
            Prefer a keyboard-driven workflow?
          </h3>
          <p class="text-xs sm:text-sm text-[#94a3b8] max-w-xl" data-i18n="terminalPromoDesc">
            Explore the full developer portfolio and inspect systems through an interactive command-line interface.
          </p>
        </div>

        <a
          href="/terminal"
          class="px-6 py-3 rounded-lg bg-[#9333ea] hover:bg-[#a855f7] text-white font-bold text-sm transition-all whitespace-nowrap inline-flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-base">terminal</span>
          <span data-i18n="terminalPromoButton">$ open /terminal</span>
        </a>
      </div>
    </section>
  </main>

  <!-- Bottom Footer -->
  <footer class="border-t border-[#2d3139] bg-[#0c0e14] py-8 relative z-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[#94a3b8]">
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <a href={profile.data.githubUrl} target="_blank" rel="noreferrer noopener" class="hover:text-white transition-colors" data-i18n="footerGithub">
          [g] github
        </a>
        <a href={profile.data.linkedinUrl} target="_blank" rel="noreferrer noopener" class="hover:text-white transition-colors" data-i18n="footerLinkedin">
          [l] linkedin
        </a>
        <button id="footer-copy-email-btn" type="button" class="text-[#ddb7ff] hover:text-white transition-colors cursor-pointer" data-email={profile.data.email} data-i18n="footerEmail">
          {t.footer.email}
        </button>
        <a href="/terminal" class="text-[#a855f7] hover:text-[#ddb7ff] transition-colors" data-i18n="footerTerminal">
          [t] cli terminal
        </a>
      </div>

      <div class="flex items-center gap-3 text-[11px]">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span data-i18n="footerSystemStatus">System Status: Operational</span>
        </span>
        <span class="text-[#2d3139]">|</span>
        <span>Astro v7</span>
      </div>
    </div>
  </footer>

  <script
    type="application/json"
    id="__site-data"
    set:html={JSON.stringify({ translations, projects: initialProjects, profile: profile.data }).replace(/</g, '\\u003c')}
  ></script>
</Layout>

<script>
  type Locale = 'en' | 'es';

  const siteData = JSON.parse(document.getElementById('__site-data')!.textContent!);
  const consoleTranslations = siteData.translations;
  const realProjectsList = siteData.projects;

  let currentLang: Locale = 'es';

  function initLanguage() {
    const savedLang = localStorage.getItem('nb_portfolio_lang') as Locale;
    if (savedLang && (savedLang === 'en' || savedLang === 'es')) {
      currentLang = savedLang;
    } else {
      const browserLang = navigator.language.toLowerCase();
      currentLang = browserLang.startsWith('es') ? 'es' : 'en';
    }
    applyLanguage(currentLang);
  }

  function applyLanguage(lang: Locale) {
    currentLang = lang;
    localStorage.setItem('nb_portfolio_lang', lang);
    document.documentElement.lang = lang;

    const label = document.getElementById('lang-current-label');
    if (label) label.textContent = lang.toUpperCase();

    const t = consoleTranslations[lang];

    const setText = (id: string, text: string) => {
      const el = document.querySelector(`[data-i18n="${id}"]`);
      if (el) el.textContent = text;
    };

    // Nav
    setText('navOverview', `[1] ${t.nav.overview}`);
    setText('navProjects', `[2] ${t.nav.projects}`);
    setText('navStack', `[3] ${t.nav.stack}`);
    setText('navPhilosophy', `[4] ${t.nav.philosophy}`);
    setText('navCli', t.nav.cli);
    setText('navCopyEmail', t.nav.copyEmail);

    // Hero
    setText('heroStatusBadge', t.hero.statusBadge);
    setText('heroHeadline', t.hero.headline);
    setText('heroSubtext', t.hero.subtext);
    setText('heroCtaProjects', t.hero.ctaProjects);
    setText('heroCtaTerminal', t.hero.ctaTerminal);
    setText('heroTerminalTitle', t.hero.terminalTitle);
    setText('heroBootBrand', t.hero.bootBrand);
    setText('heroBootMem', t.hero.bootMem);
    setText('heroBootMountPrefix', t.hero.bootMountPrefix);
    setText('heroBootReady', t.hero.bootReady);
    setText('heroTerminalRole', t.hero.terminalRole);
    setText('heroTerminalInfra', t.hero.terminalInfra);
    setText('heroFooterNote', t.hero.footerNote);

    // Projects
    setText('projectsTitle', t.projects.title);
    setText('projectsSubtitle', t.projects.subtitle);
    setText('projectsCountBadge', t.projects.countBadge.replace('{count}', String(realProjectsList.length)));
    document.querySelectorAll('[data-i18n="projectsViewCode"]').forEach(el => el.textContent = t.projects.viewCode);
    document.querySelectorAll('[data-i18n="projectsLiveDemo"]').forEach(el => el.textContent = t.projects.liveDemo);

    // Project Cards
    realProjectsList.forEach(proj => {
      setText(`projectCat_${proj.id}`, proj.category[lang]);
      setText(`projectDesc_${proj.id}`, proj.description[lang]);
      proj.metrics[lang].forEach((m, idx) => {
        setText(`projectMetric_${proj.id}_${idx}`, m);
      });
    });

    // Stack
    setText('stackTitle', t.stack.title);
    setText('stackSubtitle', t.stack.subtitle);
    setText('stackStatusBadge', t.stack.statusBadge);

    // Philosophy
    setText('philosophyTitle', t.philosophy.title);
    setText('philosophySubtitle', t.philosophy.subtitle);
    setText('philosophyItem1Title', t.philosophy.item1Title);
    setText('philosophyItem1Desc', t.philosophy.item1Desc);
    setText('philosophyItem2Title', t.philosophy.item2Title);
    setText('philosophyItem2Desc', t.philosophy.item2Desc);
    setText('philosophyItem3Title', t.philosophy.item3Title);
    setText('philosophyItem3Desc', t.philosophy.item3Desc);

    // Terminal Promo
    setText('terminalPromoTitle', t.terminalPromo.title);
    setText('terminalPromoDesc', t.terminalPromo.desc);
    setText('terminalPromoButton', t.terminalPromo.button);

    // Footer
    setText('footerGithub', t.footer.github);
    setText('footerLinkedin', t.footer.linkedin);
    setText('footerEmail', t.footer.email);
    setText('footerTerminal', t.footer.terminal);
    setText('footerSystemStatus', t.footer.systemStatus);
  }

  function showToast(message: string) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = 'px-4 py-2.5 rounded bg-[#191b22] border border-[#a855f7] text-white text-xs font-mono shadow-2xl flex items-center gap-2 animate-toast pointer-events-auto';
    toast.innerHTML = `
      <span class="material-symbols-outlined text-[#a855f7] text-base">check_circle</span>
      <span>${message}</span>
    `;

    container.appendChild(toast);
    setTimeout(() => {
      toast.remove();
    }, 2300);
  }

  function setupClipboard() {
    const copyButtons = [
      document.getElementById('nav-copy-email-btn'),
      document.getElementById('hero-copy-email-btn'),
      document.getElementById('footer-copy-email-btn')
    ];

    copyButtons.forEach(btn => {
      if (!btn) return;
      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email') || siteData.profile.email;
        try {
          await navigator.clipboard.writeText(email);
          const t = consoleTranslations[currentLang];
          showToast(t.footer.copiedToast);
        } catch (err) {
          showToast(`Email: ${email}`);
        }
      });
    });
  }

  function runBootSequence() {
    const lines = document.querySelectorAll('#boot-screen .post-line[data-step]');
    if (!lines.length) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      lines.forEach((line) => line.classList.add('lit', 'ok'));
      return;
    }

    lines.forEach((line, i) => {
      setTimeout(() => {
        line.classList.add('lit');
        if (i > 0) {
          lines[i - 1].classList.add('ok');
        }
      }, 350 + i * 420);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initLanguage();
    setupClipboard();
    runBootSequence();

    const langBtn = document.getElementById('lang-toggle-btn');
    if (langBtn) {
      langBtn.addEventListener('click', () => {
        const nextLang: Locale = currentLang === 'es' ? 'en' : 'es';
        applyLanguage(nextLang);
      });
    }
  });
</script>